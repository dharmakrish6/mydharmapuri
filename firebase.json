{
  "firestore": {
    "rules": "backend/firestore.rules",
    "indexes": "backend/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "app",
      "public": "backend/hosting-redirect",
      "ignore": [
        "**/.*"
      ],
      "redirects": [
        {
          "regex": "^/([^_].*)?$",
          "destination": "https://mydharmapuri.com/:1",
          "type": 301
        }
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
