# MyDharmapuri website — server rules for Hostinger (Apache / LiteSpeed).
# Mirrors the "app" hosting config in firebase.json. Upload with the rest of app/dist into public_html.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always https://mydharmapuri.com (no www). Local test hosts are left alone.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?([^:]+) [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Clean URLs: /index.html → /, /about.html → /about, /about/ → /about
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /about → about.html (every pre-rendered page)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Places/categories added after the last build still open, via the app's page templates.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^place/[^/]+$ /place/[id].html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^category/[^/]+$ /category/[key].html [L]
</IfModule>

<IfModule mod_headers.c>
  # Pages: re-check every 5 minutes so new deploys show up quickly.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  # Fingerprinted bundles and images never change: cache for a year.
  <FilesMatch "([-.][0-9a-f]{32})\.(js|css|png|jpe?g|webp|svg|ttf|otf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Clean-up worker for the old Flutter site: browsers must always fetch the latest copy.
  <FilesMatch "^flutter_service_worker\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>
