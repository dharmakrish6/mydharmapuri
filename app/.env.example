# Firebase console → Project settings → Your apps → Web app → SDK config.
# Copy this file to .env and fill in the values. These are public client
# keys (not secrets) — access is controlled by backend/firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# For Google sign-in on Android/iOS builds: the "Web client" OAuth client ID
# (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
